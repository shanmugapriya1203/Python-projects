from ursina import *
from ursina.prefabs.first_person_controller import FirstPersonController
import random

app = Ursina()

# GAME STATE
score = 0
health = 3
ammo = 10
game_over = False
enemies = []
shoot_cooldown = 0

# WORLD
ground = Entity(
    model="plane",
    scale=(40,1,40),
    color=color.blue,
    texture="white_cube",
    texture_scale=(40,40),
    collider="box",
)

Sky()

Wall_data = [
    (0,2,20,40,4,1),
    (0,2,-20,40,4,1),
    (20,2,0,1,4,40),
    (-20,2,0,1,4,40),
]

for wx,wy,wz,sx,sy,sz in Wall_data:
    Entity(model="cube", position=(wx,wy,wz), scale=(sx,sy,sz), color=color.dark_gray, collider="box")

# Obstacles
for _ in range(12):
    Entity(
        model="cube",
        position=(random.uniform(-15,15),0.5,random.uniform(-15,15)),
        scale=1.5,
        color=color.light_gray,
        collider="box"
    )

# PLAYER
player = FirstPersonController(position=(0,1,0), speed=8)
player.cursor.visible = False

# Crosshair
Entity(parent=camera.ui, model="quad", color=color.white, scale=0.02)

# Gun
Entity(parent=camera, model="cube", scale=(0.15,0.1,0.5), position=(0.4,-0.3,0.8), color=color.dark_gray)

# UI
score_text = Text(text="Score:0", position=(-0.85,0.45), scale=2)
health_text = Text(text="❤ ❤ ❤", position=(-0.85,0.38), scale=2, color=color.red)
ammo_text = Text(text="Ammo:10", position=(0.6,-0.43), scale=2, color=color.yellow)
message_text = Text(text="", origin=(0,0), scale=3, color=color.orange)

def update_ui():
    score_text.text = f"Score:{score}"
    health_text.text = "❤ " * health if health > 0 else "DEAD"
    ammo_text.text = f"Ammo:{ammo}"

# ENEMIES
def spawn_enemy():
    x = random.uniform(-18,18)
    z = random.uniform(-18,18)

    enemy = Entity(
        model="cube",
        position=(x,1,z),
        scale=(1,2,1),
        color=color.red,
        collider="box"
    )
    enemy.speed = random.uniform(1.5,3)
    enemy.hp = 1
    enemies.append(enemy)

for _ in range(6):
    spawn_enemy()

# SHOOT
def shoot():
    global ammo, score, shoot_cooldown

    if game_over or ammo <= 0 or shoot_cooldown > 0:
        return

    ammo -= 1
    shoot_cooldown = 0.25
    update_ui()

    ray = raycast(camera.world_position, camera.forward, distance=50, ignore=[player])

    if ray.hit and ray.entity in enemies:
        enemy = ray.entity
        enemies.remove(enemy)
        destroy(enemy)

        score += 10
        update_ui()

        invoke(spawn_enemy, delay=1.5)

    if ammo <= 0:
        message_text.text = "Reloading..."
        invoke(reload, delay=2)

def reload():
    global ammo
    ammo = 10
    message_text.text = ""
    update_ui()

def update():
    global health, game_over, shoot_cooldown

    if game_over:
        return

    if held_keys["left mouse"]:
        shoot()

    if shoot_cooldown > 0:
        shoot_cooldown -= time.dt

    for enemy in enemies[:]:
        direction = player.position - enemy.position
        direction.y = 0

        if direction.length() > 0:
            enemy.position += direction.normalized() * enemy.speed * time.dt

        if distance(enemy.position, player.position) < 1.5:
            health -= 1
            enemies.remove(enemy)
            destroy(enemy)
            update_ui()

            if health <= 0:
                game_over = True
                message_text.text = f"GAME OVER\nScore:{score}\nPress R"
                mouse.locked = False
            else:
                message_text.text = "Ouch!"
                invoke(lambda: setattr(message_text, 'text', ''), delay=1)

    if player.y < 0:
        player.y = 1

def input(key):
    global score, health, ammo, game_over

    if key == "r" and game_over:
        restart()

    if key == "escape":
        application.quit()

def restart():
    global score, health, ammo, game_over

    for e in enemies:
        destroy(e)
    enemies.clear()

    score = 0
    health = 3
    ammo = 10
    game_over = False
    player.position = (0,1,0)
    mouse.locked = True
    message_text.text = ""

    for _ in range(6):
        spawn_enemy()

    update_ui()

# START
window.title = "Beginner FPS - Ursina"
window.borderless = False

update_ui()
app.run()
